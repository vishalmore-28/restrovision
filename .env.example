# ==============================================================================
# RESTROVISION v2.0 — Production Environment Configuration Template
# Copy this file to .env and replace placeholder values with your production secrets.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Oracle Database 26ai Free / 19c Enterprise)
# ------------------------------------------------------------------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=freepdb1

# Dual-Account Security Architecture:
# Migration Account: Schema owner & DDL administrator (10 GB quota)
ORACLE_MIGRATION_USERNAME=restrovision_migrator
ORACLE_MIGRATION_PASSWORD=ReplaceWithStrongMigratorPassword2026#

# Runtime Application Account: Least-privilege connection pool (0 quota, DML only)
ORACLE_APP_USERNAME=restrovision_app
ORACLE_APP_PASSWORD=ReplaceWithStrongAppPassword2026#

# Flyway Settings:
ORACLE_SCHEMA=RESTROVISION_MIGRATOR
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# HS512 JWT signing secret (minimum 64 characters / 512 bits of high entropy):
RESTROVISION_JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Token Expiration Settings (Milliseconds):
RESTROVISION_JWT_EXPIRATION_MS=900000        # 15 minutes
RESTROVISION_JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days

# Edge AI HMAC-SHA256 Shared Secret (for authenticating IoT camera/inference events):
RESTROVISION_EDGE_HMAC_SECRET=8f4a2b1c9e3d7a5f6e8b0c2d4e6f8a0b1c3d5e7f9a1b3c5d7e9f1a3b5c7d9e1f

# Cookie Security (true in production HTTPS, false only in local HTTP dev):
RESTROVISION_COOKIE_SECURE=true

# Reverse Proxy & Trusted CIDRs:
RESTROVISION_TRUSTED_PROXIES=172.28.0.0/16,127.0.0.1

# ------------------------------------------------------------------------------
# 3. EDGE AI SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
EDGE_NODE_ID=edge-pune-01
RESTAURANT_ID=1
SPRING_BOOT_URL=http://backend:8080
SERVICE_TOKEN=ReplaceWithSignedEdgeDeviceJwtToken

# Freshness & Drift Tolerance:
RESTROVISION_MAX_EVENT_AGE_SECONDS=7200
RESTROVISION_CLOCK_SKEW_TOLERANCE_SECONDS=600

# ------------------------------------------------------------------------------
# 4. DOCKER CONTAINER IMAGE REFERENCES (FOR docker-compose.prod.yml)
# ------------------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/restrovision/restrovision-backend:2.0.0
FRONTEND_IMAGE=ghcr.io/restrovision/restrovision-frontend:2.0.0
EDGE_AI_IMAGE=ghcr.io/restrovision/restrovision-edge-ai:2.0.0

# ------------------------------------------------------------------------------
# 5. NETWORKING & PORT MAPPINGS
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
EDGE_AI_PORT=8000
